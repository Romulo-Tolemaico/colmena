# Cadena de conexión a PostgreSQL (con PostGIS habilitado en la base)
DATABASE_URL=

# Secreto usado para firmar y verificar los JWT (usar un valor largo y aleatorio)
JWT_SECRET=

# Puerto en el que escucha el servidor HTTP
PORT=

# Orígenes permitidos para CORS, separados por coma (app web y app mobile)
CORS_ORIGENES=
# Carpeta local donde se guardan archivos subidos (fotos, PDFs).
# Opcional: por defecto "./uploads". En Render (free tier) el filesystem
# es efímero, así que estos archivos se pierden en cada redeploy/restart.
CARPETA_ARCHIVOS=./uploads
